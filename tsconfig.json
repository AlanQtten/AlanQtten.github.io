{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": [
    "docs/**/*.ts",
    "docs/.vitepress/**/*.ts",
    "docs/.vitepress/**/*.mts",
    "types/**/*.d.ts"
  ]
}
